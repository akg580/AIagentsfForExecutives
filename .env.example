# ─────────────────────────────────────────────────────────────────────────────
# RAG Executive Analyst — Environment Variables
# Copy this file to .env and fill in your values.
# ALL keys below have free tiers — no credit card required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API (FREE) ──────────────────────────────────────────────────────────
# Get key at: https://console.groq.com
# Free tier: 6,000 tokens/min, 500,000 tokens/day
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1

# ── Tavily Web Search (FREE) ─────────────────────────────────────────────────
# Get key at: https://tavily.com → Dashboard → API Keys
# Free tier: 1,000 searches/month
TAVILY_API_KEY=tvly-your_tavily_key_here

# ── ChromaDB (LOCAL — no key needed) ─────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_executive_analyst

# ── Embeddings (LOCAL — no key needed) ───────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── Reranker (LOCAL — no key needed) ─────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RETRIEVAL_TOP_K=20

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_me_to_a_random_32_char_string
UPLOAD_DIR=./data/uploads
REPORTS_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=50

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:8501
